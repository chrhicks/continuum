{
  "name": "continuum",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "bin": {
    "continuum": "apps/cli/src/index.ts"
  },
  "scripts": {
    "continuum": "bun run apps/cli/src/index.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test packages/core packages/mcp apps/cli tools/import-v1",
    "validate": "bun run typecheck && bun run test",
    "install:global": "bun link",
    "setup": "bun install && bun run install:global"
  },
  "devDependencies": {
    "bun-types": "^1.3.8",
    "prettier": "^3.8.1",
    "typescript": "^5.8.2"
  }
}
