[Unit]
Description=Linear agent role (%i), one bounded action
Documentation=https://github.com/chrhicks/continuum/tree/ops/simple-agent-roles/ops/linear-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=%h/.local/libexec/linear-agent/run-once %i
TimeoutStartSec=100min
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linear-agent-%i
