# Copy to ~/.config/linear-agent/continuum.env and chmod 600.
# This file contains identifiers and paths, not API tokens. Configure Linear
# credentials in the Effect agent's MCP configuration.

LINEAR_AGENT_REPO=/home/chicks/workspaces/agents/continuum-control
LINEAR_AGENT_PROMPT=/home/chicks/.local/share/linear-agent/worker.md
LINEAR_AGENT_OPENCODE_BIN=/home/chicks/.bun/bin/opencode
LINEAR_AGENT_AGENT=effect

# Optional. Leave unset to use the agent's configured model and variant.
# LINEAR_AGENT_MODEL=openai/gpt-5.3-codex
# LINEAR_AGENT_VARIANT=high
# OPENCODE_CONFIG=/home/chicks/.config/opencode/linear-agent.json

LINEAR_AGENT_PROJECT='Continuum XDG Storage and R2 Hardening'
LINEAR_AGENT_ASSIGNEE=me
LINEAR_AGENT_ROUTING_LABEL=agent:effect

# Use the team's stock statuses for the pilot. A lease comment distinguishes
# claimed work from ordinary In Progress work. Blocked work returns to Backlog
# with the needs-human label.
LINEAR_AGENT_READY_STATUS=Todo
LINEAR_AGENT_CLAIMED_STATUS='In Progress'
LINEAR_AGENT_IN_PROGRESS_STATUS='In Progress'
LINEAR_AGENT_IN_REVIEW_STATUS='In Review'
LINEAR_AGENT_BLOCKED_STATUS=Backlog

# Comma-separated exact branch names. The worker prompt must reject every other base.
LINEAR_AGENT_ALLOWED_BASES=master,feature/xdg-storage-migration

LINEAR_AGENT_WORKTREE_ROOT=/home/chicks/workspaces/agents/continuum-control/.linear-agent-worktrees
LINEAR_AGENT_LEASE_MINUTES=120
LINEAR_AGENT_HEARTBEAT_MINUTES=20
LINEAR_AGENT_MAX_RUNTIME=90m

# Keep this enabled through installation, MCP verification, and the first manual run.
LINEAR_AGENT_DRY_RUN=1
