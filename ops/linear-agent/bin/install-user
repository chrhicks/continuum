#!/usr/bin/env bash
set -euo pipefail

profile=continuum-worker
role=worker
enable=0
for arg in "$@"; do
  case "$arg" in
    --enable) enable=1 ;;
    --profile=*) profile=${arg#*=} ;;
    --role=*) role=${arg#*=} ;;
    *) printf 'usage: %s [--profile=NAME] [--role=scout|worker|reviewer] [--enable]\n' "$0" >&2; exit 64 ;;
  esac
done
if [[ ! $profile =~ ^[a-zA-Z0-9._-]+$ ]]; then
  printf 'invalid profile: %s\n' "$profile" >&2
  exit 64
fi
if [[ $role != scout && $role != worker && $role != reviewer ]]; then
  printf 'invalid role: %s\n' "$role" >&2
  exit 64
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
libexec_home=$HOME/.local/libexec
unit_home=$config_home/systemd/user
config=$config_home/linear-agent/$profile.env

atomic_install() {
  local source=$1 destination=$2 mode=$3 temporary
  install -d "$(dirname "$destination")"
  temporary=$(mktemp "$destination.tmp.XXXXXX")
  if ! install -m "$mode" "$source" "$temporary" || ! mv -f "$temporary" "$destination"; then
    rm -f "$temporary"
    return 1
  fi
}

# A running Bash process can still be reading run-once. Replace runtime files by
# rename so active processes retain their original inode and new runs get the
# complete new version.
atomic_install "$root/bin/run-once" "$libexec_home/linear-agent/run-once" 0755
atomic_install "$root/bin/status" "$HOME/.local/bin/linear-agent-status" 0755
atomic_install "$root/prompts/worker.md" "$data_home/linear-agent/worker.md" 0644
atomic_install "$root/prompts/scout.md" "$data_home/linear-agent/scout.md" 0644
atomic_install "$root/prompts/reviewer.md" "$data_home/linear-agent/reviewer.md" 0644
atomic_install "$root/systemd/linear-agent-worker@.service" "$unit_home/linear-agent-worker@.service" 0644
atomic_install "$root/systemd/linear-agent-worker@.timer" "$unit_home/linear-agent-worker@.timer" 0644

case "$role" in
  scout) config_template=$root/config/scout.env.example ;;
  worker) config_template=$root/config/continuum.env.example ;;
  reviewer) config_template=$root/config/reviewer.env.example ;;
esac

if [[ ! -e $config ]]; then
  install -Dm600 "$config_template" "$config"
  printf 'created disabled-by-default %s config: %s\n' "$role" "$config"
else
  printf 'preserved existing config: %s\n' "$config"
fi

systemctl --user daemon-reload
printf 'installed linear-agent %s for profile %s\n' "$role" "$profile"
printf 'first run: systemctl --user start linear-agent-worker@%s.service\n' "$profile"
printf 'logs: journalctl --user -u linear-agent-worker@%s.service\n' "$profile"

if (( enable )); then
  systemctl --user enable --now "linear-agent-worker@$profile.timer"
  printf 'enabled timer; config still controls LINEAR_AGENT_DRY_RUN\n'
else
  printf 'timer not enabled; pass --enable only after a successful dry run\n'
fi
